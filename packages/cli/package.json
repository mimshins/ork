{
  "name": "@krapht/ork",
  "version": "1.0.0-alpha.16",
  "description": "Orchestrate coding agents (Claude Code, OpenCode, Command Code) on your machine: hierarchical, serializable workflows with a CLI and a localhost UI.",
  "keywords": [
    "agents",
    "coding-agents",
    "orchestration",
    "workflow",
    "cli",
    "ai-engineering",
    "claude",
    "claude-code",
    "opencode",
    "command-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimshins/ork.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/mimshins/ork/issues"
  },
  "homepage": "https://github.com/mimshins/ork#readme",
  "type": "module",
  "bin": {
    "ork": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=24.20.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm --filter @krapht/ork-ui build && node ../../tools/release/build-info.ts && node ../../tools/release/plugin-skills.ts && node ../../tools/release/builtin-workflows.ts && node ../../tools/release/issues-workflow.ts && tsdown && cp ../../LICENSE ../../THIRD_PARTY_NOTICES.md . && cp -R ../ui/dist dist/ui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "citty": "0.2.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@krapht/ork-core": "workspace:*",
    "@krapht/ork-integrations": "workspace:*",
    "@krapht/ork-nodes": "workspace:*",
    "@krapht/ork-runtime": "workspace:*",
    "@krapht/ork-schema": "workspace:*",
    "@krapht/ork-server": "workspace:*",
    "@krapht/ork-ui": "workspace:*",
    "tsdown": "0.23.4"
  }
}
