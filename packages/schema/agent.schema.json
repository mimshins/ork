{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "description": "Reasoning effort. Default: Claude Code's for the model."
    },
    "driver": {
      "type": "string",
      "enum": [
        "sdk",
        "cli"
      ]
    },
    "skills": {
      "description": "Node-layer skills (highest precedence).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "description": "Node-layer context files.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isolation": {
      "type": "string",
      "enum": [
        "worktree",
        "shared",
        "readonly"
      ]
    },
    "budgetUsd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxTurns": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "practices": {
      "type": "object",
      "properties": {
        "caveman": {
          "description": "Terse voice in chat, reports and messages. Default: on.",
          "type": "boolean"
        },
        "ponytail": {
          "description": "Smallest complete change. true is full. Default: full.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "lite",
                "full",
                "ultra"
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "schema": {
          "description": "Extra structured fields the node must report, e.g. { verdict: [approve, escalate] }.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/mimshins/ork/main/packages/schema/agent.schema.json",
  "title": "Ork agent settings"
}
