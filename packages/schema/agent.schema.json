{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "description": "Reasoning effort. Default: Claude Code's for the model."
    },
    "driver": {
      "type": "string",
      "enum": [
        "claude-code",
        "open-code",
        "command-code"
      ]
    },
    "skills": {
      "description": "Node-layer skills (highest precedence).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "description": "Node-layer context files.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isolation": {
      "type": "string",
      "enum": [
        "worktree",
        "continue",
        "shared",
        "readonly"
      ]
    },
    "budgetUsd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxTurns": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "timeout": {
      "description": "How long the node may work, e.g. 30m; time waiting on the user does not count.",
      "type": "string",
      "pattern": "^\\d+[smh]$"
    },
    "practices": {
      "type": "object",
      "properties": {
        "caveman": {
          "description": "Terse voice in chat, reports and messages. Default: on.",
          "type": "boolean"
        },
        "ponytail": {
          "description": "Smallest complete change. `true` is `full`. Default: `full`.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "lite",
                "full",
                "ultra"
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "only": {
          "description": "The only built-in tools the session has; Ork's tools stay.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "session": {
      "description": "When the node runs again (a loop, another delegation): resume its session, or start a fresh one with the new input. Default: resume for a leader, fresh for a worker.",
      "type": "string",
      "enum": [
        "fresh",
        "resume"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "schema": {
          "description": "Extra structured fields the node must report, e.g. { verdict: [approve, escalate] }.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "list": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "boolean"
                            ]
                          }
                        },
                        {
                          "type": "string",
                          "enum": [
                            "string",
                            "number",
                            "integer",
                            "boolean"
                          ]
                        }
                      ]
                    },
                    "description": "The fields each item has, e.g. { title: string }; { } for no shape."
                  }
                },
                "required": [
                  "list"
                ],
                "additionalProperties": false,
                "description": "A list of items, such as a plan's tasks."
              },
              {}
            ]
          }
        },
        "gather": {
          "description": "List fields kept across rounds: each round's entries are added to the earlier rounds' instead of replacing them, e.g. [decisions].",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/mimshins/ork/main/packages/schema/agent.schema.json",
  "title": "Ork agent settings"
}
