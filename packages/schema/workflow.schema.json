{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "description": "Default: string.",
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "layers": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project": {
          "type": "object",
          "properties": {
            "instructions": {
              "description": "Default: inherit.",
              "type": "string",
              "enum": [
                "inherit",
                "ignore"
              ]
            },
            "skills": {
              "description": "Default: inherit.",
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "inherit",
                    "ignore"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "allow": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "allow"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "driver": {
          "type": "string",
          "enum": [
            "sdk",
            "cli"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "Reasoning effort. Default: Claude Code's for the model."
        },
        "isolation": {
          "type": "string",
          "enum": [
            "worktree",
            "shared",
            "readonly"
          ]
        },
        "budgetUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxTurns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "practices": {
          "type": "object",
          "properties": {
            "caveman": {
              "description": "Terse voice in chat, reports and messages. Default: on.",
              "type": "boolean"
            },
            "ponytail": {
              "description": "Smallest complete change. true is full. Default: full.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "lite",
                    "full",
                    "ultra"
                  ]
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "description": "Rules for what Ork does on its own (git, permissions); they win over the project's .ork/project.yaml.",
      "type": "object",
      "properties": {
        "git": {
          "type": "object",
          "properties": {
            "commit": {
              "description": "Default: auto, Ork commits a node's work on its branch. never: Ork runs no git commit; worktrees are detached and work stays uncommitted.",
              "type": "string",
              "enum": [
                "auto",
                "never"
              ]
            },
            "merge": {
              "description": "How a passing child's work reaches its owner. auto: a --no-ff merge (needs commits). patch: its changes are applied, uncommitted. never: left in its own worktree. Default: auto, or patch under commit: never.",
              "type": "string",
              "enum": [
                "auto",
                "patch",
                "never"
              ]
            },
            "base": {
              "description": "The commit worktrees without an owner start from, e.g. origin/main. Default: HEAD. Ork never fetches.",
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "description": "Branch name template over {run}, {node}, {clone} and {inputs.<name>}. Default: ork/{run}/{node}.",
              "type": "string",
              "minLength": 1
            },
            "worktrees": {
              "description": "Worktree folder template, relative to the clone, beside it. Default: ../{clone}-worktrees/ork-{run}-{node}.",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "permissions": {
          "description": "Tool rules every Claude node gets on top of its own, e.g. deny: ['Bash(git push *)'].",
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "description": "Agents defined in this workflow; they win over the project's and the user's of the same name.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "description": "When to use this agent; tools show it when choosing one.",
            "type": "string"
          },
          "instructions": {
            "description": "The agent's role, appended to the system prompt of its nodes.",
            "type": "string"
          },
          "model": {
            "type": "string",
            "minLength": 1
